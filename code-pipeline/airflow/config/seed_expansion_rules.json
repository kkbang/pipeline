{
  "repo_content_expansion_v1": {
    "rule_type": "repo_content_expansion",
    "enabled": true,
    "max_registered_repos": 60,
    "max_children_per_repo": 20,
    "include_readme_links": true,
    "include_dependency_manifests": true
  },
  "repo_relation_enrichment_v1": {
    "rule_type": "repo_relation_enrichment",
    "enabled": true,
    "max_registered_repos": 80,
    "include_same_owner_relations": true,
    "include_same_project_family_relations": true,
    "include_fork_relations": true,
    "max_pairs_per_group": 100
  }
}
